# Supabase: Project Settings -> Database -> Connection string (use the Transaction pooler URI)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@healthplans.ai
ADMIN_PASSWORD=ChangeMe123!
PORT=4000

# 64 hex chars. Encrypts hidden tests / MCQ answers in the frontend bank; keys are released by the API only to authorised users.
BANK_MASTER_KEY=<64-hex-chars>

# Max candidates per session (live links + used links + directly assigned). Raise only after a capacity test.
MAX_CANDIDATES_PER_SESSION=50
# pg pool size per instance (Render free: keep 6-8)
PG_POOL_MAX=8

# ---- Forgot password for proctors: optional email (HTTPS only; Render free blocks SMTP) ----
# Leave these empty to use ADMIN-ASSISTED mode: requests wait in Admin > Users > "Password reset requests".
# To email links automatically (Resend: https://resend.com), set ALL FOUR. EMAIL_FROM must be a verified sender/domain.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="HPAI Assessment <no-reply@yourdomain.com>"
# APP_URL=https://your-frontend.vercel.app        # no trailing slash; reset links are APP_URL/reset-password/<token>
# RESET_LINK_MINUTES=30                           # how long a reset link stays valid (5-1440)
